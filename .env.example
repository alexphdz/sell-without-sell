# Kipu Anonymizer — Local Development Environment Variables
# Copy this file to .env and fill in values. .env is gitignored.

# Application
APP_NAME=kipu-anonymizer
APP_VERSION=0.1.0
TEAM_NAME=your-team-name
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL (used by app and Docker Compose)
DATABASE_URL=postgresql+asyncpg://kipu:kipu_dev_pass@127.0.0.1:5432/kipu_dev
POSTGRES_DB=kipu_dev
POSTGRES_USER=kipu
POSTGRES_PASSWORD=kipu_dev_pass

# Frontier Sources API (Module 01+)
# BASE_URL=https://reto-pii-fuentes-production.up.railway.app/v1
# API_TOKEN=your-frontier-token-here
